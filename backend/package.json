{
  "name": "@aluguel/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:contracts": "tsx --test tests/contracts/*.test.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aluguel/shared": "file:../packages/shared",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1",
    "jose": "^6.2.12",
    "openai": "^7.5.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2"
  }
}
