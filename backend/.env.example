DB_HOST=localhost
# Docker (backend no Compose): DB_HOST=host.docker.internal aponta para Postgres no host/WSL.
DATABASE_NAME=alugueldiscovery
DB_USER=aluguel
DB_PASSWORD=aluguel_dev_docker
DB_PORT=5432
DB_SSL=false
DB_POOL_MAX=10

AUTH_SECRET=<YOUR_AUTH_SECRET>
API_HOST=0.0.0.0
# Desenvolvimento (npm run dev): 3006. Homologação Docker usa 3001 (override no Compose).
API_PORT=3006
FRONTEND_ORIGIN=http://localhost:3005

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

ADMIN_EMAILS=

# WhatsApp via Evolution API (stack em docker/evolution no host/WSL)
# npm run dev (API no host): http://127.0.0.1:8080
# Backend no Docker Compose: http://host.docker.internal:8080 (override automático se BACKEND_IN_DOCKER=true)
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=radar-imoveis
