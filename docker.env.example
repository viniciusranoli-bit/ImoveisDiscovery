# Homologação Docker — interpolação do Compose (copie para .env na raiz se quiser).
APP_PORT=3000
API_PORT=3001
# Dev local (npm run dev): frontend 3005, API 3006 — não usa este arquivo.

# Não defina DB_HOST=localhost na raiz ao usar Docker — o Compose fixa host.docker.internal no backend.
# Credenciais do banco: backend/.env (DATABASE_NAME, DB_USER, DB_PASSWORD). DB_HOST=localhost vale só para npm run dev local.
