{
  "name": "alugueldiscovery",
  "version": "1.0.0",
  "description": "Painel multiportal de monitoramento de imóveis para aluguel e compra",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/prepare-local-dev.mjs && concurrently --names frontend,backend --prefix-colors cyan,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace backend",
    "test:contracts": "npm run test:contracts --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:check": "npm run db:check --workspace backend",
    "docker:up": "docker compose up --build -d",
    "docker:up:backend": "docker compose -f backend/docker-compose.yml up --build -d",
    "docker:up:frontend": "docker compose -f frontend/docker-compose.yml up --build -d",
    "docker:down": "docker compose down",
    "docker:down:backend": "docker compose -f backend/docker-compose.yml down",
    "docker:down:frontend": "docker compose -f frontend/docker-compose.yml down",
    "docker:logs": "docker compose logs -f",
    "docker:logs:backend": "docker compose -f backend/docker-compose.yml logs -f",
    "docker:logs:frontend": "docker compose -f frontend/docker-compose.yml logs -f",
    "docker:evolution:sync-env": "node scripts/sync-evolution-backend-env.mjs",
    "docker:evolution:up": "node scripts/prepare-evolution-env.mjs && docker compose -f docker/evolution/docker-compose.yml --env-file docker/evolution/.env up -d",
    "docker:evolution:down": "docker compose -f docker/evolution/docker-compose.yml down"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.2"
  }
}
